# API: Express + Prisma/SQLite. Слушает только localhost, наружу — через nginx.
[Unit]
Description=Позиция — API
After=network-online.target pozitsiya-converter.service
Wants=network-online.target

[Service]
Type=simple
User=pozitsiya
WorkingDirectory=/opt/pozitsiya/server
EnvironmentFile=/opt/pozitsiya/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
