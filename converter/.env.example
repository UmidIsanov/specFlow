# Скопируйте в .env и вставьте ключ. Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Модели (необязательно): чертежи и коммерческие предложения
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_KP=gemini-pro-latest
# Бюджет «размышлений» модели (токены). По умолчанию 2048; -1 — без ограничения
# GEMINI_THINKING_BUDGET=2048
# GEMINI_THINKING_BUDGET_KP=2048
