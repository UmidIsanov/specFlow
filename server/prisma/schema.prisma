// SpecFlow — учёт слаботочных систем на объекте
// SQLite: enum не поддерживается, статусы храним строками (см. src/lib/enums.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  code      String?
  customer  String?
  address   String?
  status    String   @default("ACTIVE") // ACTIVE | DONE | PAUSED
  createdAt DateTime @default(now())
  /// Кто завёл объект. Необязателен, пока старые объекты не получили владельца
  /// скриптом `npm run access:init` — после прогона на сервере поле станет обязательным.
  ownerId   String?

  owner   User?           @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  invites Invite[]

  requests    Request[]
  specItems   SpecItem[]
  offers      Offer[]
  deliveries  Delivery[]
  acts        WorkAct[]
  stockMoves  StockMove[]
  deviations  Deviation[]
  itdScopes   ItdScope[]
  itdRecords  ItdRecord[]

  @@index([ownerId])
}

/// Заявка на закупку: номер, ревизия и позиции, которые по ней заказывают.
/// Одна заявка обычно покрывает часть объекта — по проекту 100 компьютеров,
/// в заявку попадают 50, поэтому заявок на объекте бывает несколько.
model Request {
  id        String   @id @default(cuid())
  projectId String
  number    String? // номер заявки: 6450, 8198
  revision  Int      @default(1) // ревизия: новая не стирает предыдущую, встаёт рядом
  title     String? // чем заявка отличается от соседних: «Лотки», «Кабель»
  sourceFile String? // имя загруженного файла — откуда приехали позиции
  createdAt DateTime @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   SpecItem[]

  @@unique([projectId, number, revision])
  @@index([projectId])
}

/// Позиция проектной спецификации (то, что приходит из pdf-spec-converter)
model SpecItem {
  id           String  @id @default(cuid())
  projectId    String
  /// Заявка, по которой заказывают позицию. Необязателен, пока старые позиции
  /// не разложены по заявкам скриптом `npm run requests:init`.
  requestId    String?
  pos          String? // № по спецификации
  system       String  @default("ПС") // ПС | СКС | СОТ | АПТ | ПЕРИМЕТР | ...
  name         String
  article      String? // маркировка / артикул
  manufacturer String?
  unit         String  @default("шт")
  qtyPlan      Float   @default(0)
  pricePlan    Float?
  note         String?
  code         String? // код продукции из спецификации (RBZ-319538) — самый надёжный ключ
  tag          String? // теговый номер прибора: 402100-AIT-9001 TG
  datasheet    String? // опросный лист: MOF3-UN-402100-INS-DAT-9003
  section      String? // Оборудование | Кабели и провода | Изделия и материалы
  building     String? // здание/объект внутри площадки
  docRef       String? // шифр документа проектного института

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request    Request?       @relation(fields: [requestId], references: [id])
  offerItems OfferItem[]
  deliveries DeliveryItem[]
  actItems   WorkActItem[]
  stockMoves StockMove[]
  deviations Deviation[]

  @@index([projectId])
  @@index([requestId])
}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  inn     String?
  contact String?
  note    String?

  offers     Offer[]
  deliveries Delivery[]
}

/// Коммерческое предложение поставщика
model Offer {
  id           String   @id @default(cuid())
  projectId    String
  supplierId   String
  number       String?
  date         DateTime @default(now())
  currency     String   @default("UZS")
  deliveryDays Int?
  status       String   @default("DRAFT") // DRAFT | ANALYZED | ACCEPTED | REJECTED
  createdAt    DateTime @default(now())

  project  Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier Supplier    @relation(fields: [supplierId], references: [id])
  items    OfferItem[]

  @@index([projectId])
}

/// Строка КП + результат сопоставления со спецификацией
model OfferItem {
  id           String  @id @default(cuid())
  offerId      String
  specItemId   String?
  rawPos       String?
  rawName      String
  article      String?
  code         String? // код продукции из КП поставщика
  tagsJson     String? // теговые номера, перечисленные в строке КП
  section      String? // раздел КП: «Система 1 · Hardware», «Общее»
  datasheet    String? // опросный лист, на который ссылается строка КП
  manufacturer String?
  unit         String  @default("шт")
  qty          Float   @default(0)
  price        Float   @default(0)

  matchType       String  @default("NONE")    // EXACT | ANALOG | NONE
  matchScore      Float   @default(0)         // 0..1
  verdict         String  @default("PENDING") // PENDING | OK | ANALOG_OK | ANALOG_RISK | REJECT
  engineerComment String?
  analysisJson    String? // причины сопоставления и расхождения характеристик

  offer    Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  specItem SpecItem? @relation(fields: [specItemId], references: [id])

  @@index([offerId])
  @@index([specItemId])
}

/// Приход оборудования на объект
model Delivery {
  id         String   @id @default(cuid())
  projectId  String
  supplierId String?
  number     String?
  waybill    String? // № накладной
  date       DateTime @default(now())
  note       String?

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id])
  items    DeliveryItem[]

  @@index([projectId])
}

model DeliveryItem {
  id         String @id @default(cuid())
  deliveryId String
  specItemId String
  qty        Float  @default(0)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  specItem SpecItem @relation(fields: [specItemId], references: [id])

  @@index([deliveryId])
}

/// Акт выполненных работ / акт установки оборудования (основа ИТД)
model WorkAct {
  id        String    @id @default(cuid())
  projectId String
  number    String?
  date      DateTime  @default(now())
  location  String? // этаж / помещение / участок
  system    String    @default("ПС")
  status    String    @default("DRAFT") // DRAFT | SIGNED
  signedAt  DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   WorkActItem[]

  @@index([projectId])
}

model WorkActItem {
  id         String @id @default(cuid())
  actId      String
  specItemId String
  qty        Float  @default(0)

  act      WorkAct  @relation(fields: [actId], references: [id], onDelete: Cascade)
  specItem SpecItem @relation(fields: [specItemId], references: [id])

  @@index([actId])
}

/// Участок исполнительной: пара «объект + система + вид работы».
///
/// ИТД — отдельный контур: ни с заявкой, ни с КП он не связан. Кабель и гофра
/// идут по другим заявкам, и сопоставлять сданные работы с закупкой нельзя.
/// У участка два разных состояния: «физика принята» (заказчик принял сами
/// работы, чтобы стройка не стояла) и «пакет документов сдан» — остальные
/// 5–6 документов: входной контроль, сертификаты, трасса по проекту.
model ItdScope {
  id        String @id @default(cuid())
  projectId String
  building  String // № объекта из реестра: 401100
  system    String // система: AFS, ACS, LAN…
  workKind  String // вид работы: «Прокладка кабеля», «Лоток»
  workPack  String // пакет работ: CABLE | EQUIP | OTHER (см. lib/enums.ts)

  /// Состояние приёмки работ, посчитано по строкам реестра:
  /// ACCEPTED | PARTIAL | REMARKS | REQUESTED
  state      String    @default("REQUESTED")
  acceptedAt DateTime? // дата инспекции, которой приняли работы

  /// Пакет документов сдан — это ставит ПТО руками, в реестре инспекций такого нет.
  dossierDone Boolean   @default(false)
  dossierAt   DateTime?
  dossierNote String?

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records ItdRecord[]

  @@unique([projectId, building, system, workKind])
  @@index([projectId])
}

/// Строка реестра инспекций («Инспекция»): одна заявка на инспекцию.
/// Реестр клиент обновляет целиком раз в неделю, поэтому загрузка заменяет
/// все строки объекта, а отметки ПТО живут на участке и не стираются.
model ItdRecord {
  id        String @id @default(cuid())
  projectId String
  scopeId   String

  rowNo         String? // № в реестре
  fcn           String? // изменение проекта: «FCN № 530»
  statusText    String? // статус как написано в файле: «Сдано. 3 -этаж частично»
  state         String // ACCEPTED | PARTIAL | REMARKS | REQUESTED
  inspectionNo  String? // RFI-PRJ-QAC-INS-59653
  inspectedAt   DateTime?
  inspectedText String? // когда в клетке не дата, а заметка: «(13.05.2026) 18.05.2026»
  smrDoneAt     DateTime? // дата завершения СМР
  rawKind       String? // вид работы ровно как в файле, до приведения к общему виду

  sourceFile String?
  importedAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope   ItdScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([scopeId])
}

/// Движение ТМЦ по складу объекта
model StockMove {
  id         String   @id @default(cuid())
  projectId  String
  specItemId String
  qty        Float // + приход, - списание
  type       String // IN | OUT | ADJUST
  refType    String? // DELIVERY | ACT | MANUAL
  refId      String?
  comment    String?
  createdAt  DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specItem SpecItem @relation(fields: [specItemId], references: [id])

  @@index([projectId])
  @@index([specItemId])
}

/// Отклонение от проекта — попадает в исполнительную документацию
model Deviation {
  id          String   @id @default(cuid())
  projectId   String
  specItemId  String?
  kind        String // REPLACE | QTY_CHANGE | EXCLUDE | ADD
  description String
  approvedBy  String?
  date        DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specItem SpecItem? @relation(fields: [specItemId], references: [id])

  @@index([projectId])
}

// ───────────────────────── Доступ ─────────────────────────
// Объект видит только тот, кто его завёл, и те, кого он позвал.
// Роли храним строками (SQLite без enum, см. src/lib/enums.ts).

/// Человек, который работает с программой: инженер, прораб, ПТО, закупщик
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// scrypt: соль и хэш в одной строке, см. src/lib/password.ts
  passwordHash    String
  role            String    @default("USER") // USER | ADMIN
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?

  sessions      Session[]
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  invitesSent   Invite[]        @relation("InviteAuthor")
  invitesTaken  Invite[]        @relation("InviteGuest")
}

/// Вход с одного устройства. В cookie уходит случайный токен, в базе лежит его хэш.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Кто допущен к объекту и с какими правами
model ProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  userId      String
  role        String   @default("ENGINEER") // OWNER | ENGINEER | VIEWER
  invitedById String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// Приглашение на объект. Пока нет почтового ящика, ссылку отдаём владельцу —
/// он пересылает её человеку сам.
model Invite {
  id           String    @id @default(cuid())
  email        String
  projectId    String?
  role         String    @default("ENGINEER") // ENGINEER | VIEWER
  tokenHash    String    @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime  @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)
  accepted  User?    @relation("InviteGuest", fields: [acceptedById], references: [id])

  @@index([email])
  @@index([projectId])
}
